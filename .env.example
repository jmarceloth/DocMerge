# ==============================================================================
# IELECTRIC DocMerge - Variáveis de Ambiente (.env.example)
# ==============================================================================

# 1. Ambiente e Rede
# Em produção, ENVIRONMENT=production exige BASE_URL HTTPS pública, SECRET_KEY >= 32 chars
# e credenciais Google válidas (sem fallback silencioso para localhost ou desenvolvimento).
PORT=8000
ENVIRONMENT=production
BASE_URL=https://docmerge.ielectric.app
CORS_ORIGINS=https://docmerge.ielectric.app
TRUSTED_PROXIES=127.0.0.1,::1,172.18.0.1

# 2. Segurança e Sessão (Obrigatório em produção: mínimo 32 caracteres; gere com `openssl rand -hex 32`)
SECRET_KEY=substitua_por_uma_chave_secreta_forte_e_aleatoria
SESSION_MAX_AGE_HOURS=8

# 3. Autenticação Google OIDC (Google Cloud Console -> Web Application)
# Se GOOGLE_REDIRECT_URI não for informada, assume automaticamente ${BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_REDIRECT_URI=https://docmerge.ielectric.app/auth/callback

# Conta proprietária inicial autorizada (exclusiva no bootstrap quando o banco está vazio)
INITIAL_OWNER_EMAIL=jmarceloth@gmail.com

# 4. Persistência (Volume montado em /app/data no Coolify)
DATA_DIR=/app/data
DATABASE_PATH=/app/data/docmerge_auth.db
UPLOADS_DIR=/app/data/uploads
LETTERHEAD_PATH=/app/data/uploads/default_letterhead.pdf

# 5. Limites Operacionais de Upload e Processamento de PDF
MAX_UPLOAD_FILE_SIZE_MB=25
MAX_TOTAL_UPLOAD_SIZE_MB=60
MAX_COMBINE_FILES=20
MAX_PDF_PAGES=300
